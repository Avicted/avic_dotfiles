configuration {
	modi:                       "drun,run,filebrowser";
    show-icons:                 false;
	drun-display-format:        "{name} [<span weight='light' size='small'><i>({generic})</i></span>]";
	window-format:              "{w} · {c} · {t}";
}

// Spotlight-style: one centered dark panel, macOS blue selection.
* {
    font:             "Noto Sans 13";
    background-color: transparent;
    text-color:       #ebebf0;
    bg:               #1e1e20f2;
    sel:              #0a84ff;
    dim:              #8e8e93;
}

window {
    width:            640px;
    location:         north;
    y-offset:         22%;
    background-color: @bg;
    border:           1px;
    border-color:     #ffffff1a;
    border-radius:    12px;
}

mainbox  { padding: 10px; spacing: 8px; children: [ inputbar, listview ]; }
inputbar { padding: 6px 8px; spacing: 8px; children: [ prompt, entry ]; }
prompt   { text-color: @dim; }
entry    { placeholder: "Search"; placeholder-color: @dim; }
listview { lines: 8; scrollbar: false; spacing: 2px; }
element  { padding: 6px 10px; border-radius: 8px; }
element selected { background-color: @sel; }
element-text { text-color: inherit; }
